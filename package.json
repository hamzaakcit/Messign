{
  "name": "messign-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Gamified Digital Workspace for Messign",
  "scripts": {
    "dev": "(npx kill-port 3000 3001 || true) && concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "type-check": "npm run type-check --workspaces --if-present"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "kill-port": "^2.0.1",
    "typescript": "^5.3.3"
  }
}
