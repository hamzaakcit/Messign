{
  "name": "messign-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Gamified Digital Workspace for Messign",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "(npx kill-port 3000 3001 || true) && concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "litellm": "(npx kill-port 4000 || true) && PATH=\"$HOME/Library/Python/3.12/bin:$HOME/Library/Python/3.11/bin:$HOME/Library/Python/3.10/bin:$HOME/Library/Python/3.9/bin:$HOME/.local/bin:$PATH\" litellm --config ./litellm/config.yaml --port 4000",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "start:client": "npx serve client/dist -l $PORT",
    "type-check": "npm run type-check --workspaces --if-present"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^25.4.0",
    "concurrently": "^8.2.2",
    "kill-port": "^2.0.1",
    "typescript": "^5.3.3"
  }
}
