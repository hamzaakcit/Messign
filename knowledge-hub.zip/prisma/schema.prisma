generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ===================== AUTH & RBAC =====================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String
  avatarUrl String?
  role      Role     @default(VIEWER)
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents     Document[]     @relation("author")
  reviews       ReviewAction[]
  comments      Comment[]
  viewLogs      DocumentView[]
  auditLogs     AuditLog[]
  bookmarks     Bookmark[]
  notifications Notification[]

  @@map("users")
}

enum Role {
  ADMIN
  CPO
  EDITOR
  REVIEWER
  VIEWER
}

model Team {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  color       String?
  createdAt   DateTime     @default(now())
  members     User[]
  accessRules TeamAccess[]

  @@map("teams")
}

model TeamAccess {
  id         String   @id @default(uuid())
  teamId     String
  documentId String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([teamId, documentId])
  @@map("team_access")
}

// ===================== DOCUMENTS =====================

model Document {
  id           String         @id @default(uuid())
  title        String
  slug         String         @unique
  content      Json
  plainText    String?
  excerpt      String?
  coverImage   String?
  status       DocumentStatus @default(DRAFT)
  documentType DocumentType   @default(GUIDE)
  metadata     Json?
  authorId     String
  author       User           @relation("author", fields: [authorId], references: [id])
  categoryId   String?
  category     Category?      @relation(fields: [categoryId], references: [id])
  isPublic     Boolean        @default(false)
  viewCount    Int            @default(0)
  lastViewedAt DateTime?
  publishedAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tags          DocumentTag[]
  versions      DocumentVersion[]
  comments      Comment[]
  attachments   Attachment[]
  teamAccess    TeamAccess[]
  viewLogs      DocumentView[]
  reviewActions ReviewAction[]
  bookmarks     Bookmark[]
  outgoingLinks DocumentLink[] @relation("source")
  incomingLinks DocumentLink[] @relation("target")

  @@map("documents")
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum DocumentType {
  GUIDE
  FAQ
  SPECIFICATION
  ROADMAP
  MEETING_NOTE
  MICRO_LEARN
  ANNOUNCEMENT
  TEMPLATE
  SOP
}

// ===================== VERSIONING =====================

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content     Json
  plainText   String?
  version     Int
  changeNote  String?
  createdById String
  createdAt   DateTime @default(now())

  @@unique([documentId, version])
  @@map("document_versions")
}

// ===================== CATEGORIES & TAGS =====================

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  color       String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  documents   Document[]
  createdAt   DateTime   @default(now())

  @@map("categories")
}

model Tag {
  id        String        @id @default(uuid())
  name      String        @unique
  slug      String        @unique
  color     String?
  documents DocumentTag[]
  createdAt DateTime      @default(now())

  @@map("tags")
}

model DocumentTag {
  documentId String
  tagId      String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@map("document_tags")
}

// ===================== COMMENTS =====================

model Comment {
  id             String    @id @default(uuid())
  documentId     String
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorId       String
  author         User      @relation(fields: [authorId], references: [id])
  content        String
  selectionStart Int?
  selectionEnd   Int?
  selectedText   String?
  parentId       String?
  parent         Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies        Comment[] @relation("CommentThread")
  isResolved     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("comments")
}

// ===================== WORKFLOW & REVIEW =====================

model ReviewAction {
  id         String     @id @default(uuid())
  documentId String
  document   Document   @relation(fields: [documentId], references: [id])
  reviewerId String
  reviewer   User       @relation(fields: [reviewerId], references: [id])
  action     ReviewType
  comment    String?
  createdAt  DateTime   @default(now())

  @@map("review_actions")
}

enum ReviewType {
  APPROVED
  REJECTED
  REQUESTED_CHANGES
}

// ===================== DOCUMENT LINKS =====================

model DocumentLink {
  id        String   @id @default(uuid())
  sourceId  String
  targetId  String
  source    Document @relation("source", fields: [sourceId], references: [id], onDelete: Cascade)
  target    Document @relation("target", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sourceId, targetId])
  @@map("document_links")
}

// ===================== ATTACHMENTS =====================

model Attachment {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileName   String
  fileType   String
  fileSize   Int
  storageUrl String
  ocrText    String?
  createdAt  DateTime @default(now())

  @@map("attachments")
}

// ===================== ANALYTICS =====================

model DocumentView {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  viewedAt   DateTime @default(now())
  duration   Int?

  @@index([documentId, viewedAt])
  @@map("document_views")
}

model SearchLog {
  id           String   @id @default(uuid())
  userId       String
  query        String
  resultCount  Int
  clickedDocId String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("search_logs")
}

// ===================== BOOKMARKS =====================

model Bookmark {
  id         String   @id @default(uuid())
  userId     String
  documentId String
  user       User     @relation(fields: [userId], references: [id])
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, documentId])
  @@map("bookmarks")
}

// ===================== NOTIFICATIONS =====================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

enum NotificationType {
  REVIEW_REQUESTED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  COMMENT_ADDED
  MENTION
  CONTENT_STALE
  SYSTEM
}

// ===================== AUDIT LOG =====================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ===================== EMBEDDINGS =====================

model DocumentEmbedding {
  id         String   @id @default(uuid())
  documentId String
  chunkIndex Int
  chunkText  String
  embedding  Unsupported("vector(1536)")
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@map("document_embeddings")
}
