{
  "include": [
    "scripts",
    "comfyui_custom_nodes",
    "convert_refs.py",
    "fix_and_upload.py",
    "generate_dora.py"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.git",
    "**/.cursor",
    "knowledge-hub",
    "knowledge-hub.zip",
    "client",
    "server/node_modules",
    "dist",
    "**/dist",
    "build",
    "**/build",
    "coverage",
    "**/coverage",
    "test-results",
    "playwright-report",
    "e2e/.auth",
    "db",
    "supabase",
    "litellm",
    "docs",
    "e2e",
    "tests",
    "assets",
    "dora_references",
    "deploy",
    "**/*.dump",
    "**/*.tsbuildinfo"
  ],
  "typeCheckingMode": "off",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none",
  "useLibraryCodeForTypes": false,
  "pythonVersion": "3.11",
  "verboseOutput": false
}
