# PostgreSQL connection string for reimbursement DB
DATABASE_URL=postgresql://user@localhost:5432/messign_reimbursement

# Optional: receipt OCR (Claude Vision)
# ANTHROPIC_API_KEY=your_key

# Optional: upload directory (default: server/uploads)
# UPLOAD_DIR=./uploads

# Optional: server port (default: 3001)
# PORT=3001

# Optional: mileage distance (GraphHopper Geocoding + Route)
# GRAPHHOPPER_API_KEY=your_key
