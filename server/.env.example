# ============== Required ==============
# PostgreSQL connection string
# CRITICAL: Use the restricted messign_app role (NOT postgres) so RLS is enforced.
# Run: ./db/scripts/run_create_app_role.sh (or psql -f db/scripts/create_app_role.sql)
# Then set DATABASE_URL to the messign_app connection string.
#
# Local dev: postgresql://messign_app:<password>@localhost:5432/messign
# Railway:   postgresql://messign_app:<password>@<host>:<port>/railway?sslmode=require
DATABASE_URL=postgresql://messign_app:YOUR_APP_PASSWORD@localhost:5432/messign
#
# If you see `permission denied for schema public` or MV refresh errors on server boot:
# the app role cannot run DDL/REFRESH. That is expected — use DATABASE_ADMIN_URL for
# migrations, or ignore those lines for local dev. For a friction-free local DB only,
# you may point DATABASE_URL at postgres (not recommended for shared/prod-shaped data).

# Admin URL for migrations (postgres/superuser). Required for db:apply-rls, db:migrate.
# If unset, falls back to DATABASE_PUBLIC_URL then DATABASE_URL.
# DATABASE_ADMIN_URL=postgresql://postgres:<password>@<host>:<port>/railway?sslmode=require

# Required for `npm run db:verify-rls`: connection string for a non-bypass, non-superuser
# role (see db/scripts/create_app_role.sql). Must NOT be the same role as DATABASE_ADMIN_URL —
# the point of this check is to prove RLS holds for a role that cannot bypass it.
# RLS_VERIFY_DATABASE_URL=postgresql://messign_app:YOUR_APP_PASSWORD@localhost:5432/messign

# Optional: force `npm run db:migrate-runner` to a specific database when DATABASE_URL points
# at cloud but you develop against local Postgres (e.g. approval queue missing on :3000).
# Use a role that exists on your machine: Homebrew Postgres often uses your macOS username, not `postgres`.
# DATABASE_MIGRATE_URL=postgresql://messign_app:YOUR_APP_PASSWORD@localhost:5432/messign
# Example (superuser / owner): postgresql://$(whoami)@localhost:5432/messign

# PgBouncer (optional): When set, app connects via PgBouncer for connection pooling.
# Must use messign_app role (same as DATABASE_URL) for RLS to work.
# Use port 6432 (PgBouncer) instead of 5432 (PostgreSQL). Requires pool_mode=transaction for RLS.
# PGBOUNCER_URL=postgresql://messign_app:YOUR_APP_PASSWORD@localhost:6432/messign_production

# Redis (required for BullMQ, cache, Dora scheduler)
# Local: redis://localhost:6379 | Railway: use Redis plugin URL
REDIS_URL=redis://localhost:6379

# Set to 1 to disable Socket.IO Redis adapter (in-memory only; not safe with multiple Railway replicas).
# SKIP_SOCKET_REDIS_ADAPTER=1
#
# Default: Engine.IO uses WebSocket only — no sticky sessions needed for Socket.IO.
# Set to 1 to allow long-polling + WebSocket (then use one replica or a sticky load balancer).
# SOCKET_ALLOW_POLLING=1

# Background workers (BullMQ, Dora scheduler). Set to false if Redis is unavailable — marketing batch jobs
# and other Redis-backed workers will not run.
# ENABLE_WORKERS=false
#
# pg-boss (Postgres-backed queue) for competitor scrape jobs and marketing batch handoff. Runs when
# DATABASE_URL is set and ENABLE_PG_BOSS is not false — independent of ENABLE_WORKERS so scrapes still
# enqueue when Redis workers are off. Requires the `pgboss` schema (created when pg-boss starts) and
# migrations that add competitor intelligence tables (e.g. server/src/migrations/100_competitor_intelligence.sql,
# 102_competitor_last_scrape_summary.sql).
# ENABLE_PG_BOSS=false
#
# Optional: direct Postgres URL for pg-boss only. Use when DATABASE_PUBLIC_URL is a transaction pooler
# (e.g. Neon) — pg-boss needs a session-capable or direct connection. If unset, order is:
# DATABASE_URL, then DATABASE_PUBLIC_URL.
# PG_BOSS_DATABASE_URL=postgresql://messign_app:...@host:5432/db?sslmode=require

# Optional: log [SLOW] when request time exceeds this many ms (default: 500 prod, 2000 dev)
# SLOW_LOG_MS=500

# Optional: set to 1 to disable IP/User-Agent fingerprint checks on JWT (debug only; not for production)
# DISABLE_SESSION_FINGERPRINT=
# Optional: set to 1 to enforce fingerprint even on localhost/LAN (default: relaxed on private hosts when NODE_ENV=production)
# SESSION_FINGERPRINT_STRICT=

# JWT secrets (use long random strings in production)
JWT_SECRET=your-access-secret-change-in-production
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# ============== Required for Production ==============
# Frontend URL for CORS (Vercel production domain, e.g. https://messign.vercel.app)
# MUST match your Vercel URL exactly (https, no trailing slash).
# Refresh cookies use SameSite=None in production; CLIENT_URL is still required so CORS allows your origin.
# CLIENT_URL=https://your-app.vercel.app

# Additional CORS origins (comma-separated, for Vercel preview URLs)
# ADDITIONAL_CORS_ORIGINS=https://messign-git-main-xxx.vercel.app,https://messign-xxx.vercel.app
#
# Allow any https://*.vercel.app origin for Express + Socket.IO (preview deploys). Prefer listing exact
# URLs in ADDITIONAL_CORS_ORIGINS when possible; use this when previews change often.
# ALLOW_VERCEL_PREVIEW_CORS=1

# PII encryption (required in production; fail-fast if unset)
# ENCRYPTION_KEY=your-64-char-hex-string-here

# ============== Optional (server) ==============
# PORT=3001
# NODE_ENV=production
# UPLOAD_DIR=./uploads
# LOG_LEVEL=info   # debug | info | warn | error (default: info in prod, debug in dev)

# Pooled / public DB URL (Neon, Supabase pooler, etc.); used as fallback when DATABASE_URL is unset
# DATABASE_PUBLIC_URL=

# ============== Optional (AI / Knowledge Hub) ==============
# GROQ_API_KEY=
# GROQ_OPENAI_BASE_URL=https://api.groq.com/openai/v1   # Override Groq base URL for OpenAI-compat calls
#
# --- Marketing / Instagram images (set at least ONE backend) ---
# Routing (default): Fal (FAL_KEY) first → Global Publisher (?key=) → Vertex OAuth → AI Studio → OpenAI Images → LiteLLM.
# Do not set IMAGE_GEN_OPENAI_GEMINI_ONLY=1 if you want Fal-first. IMAGE_GEN_DISABLE_FAL=1 skips Fal globally (still allows Gemini/OpenAI). Set IMAGE_GEN_OPENAI_BEFORE_GEMINI=1 to try OpenAI Images before Gemini after Fal fails (faster when Gemini 404/NO_IMAGE).
# Email VA2 section images: POST /api/marketing/content/:id/resolve-email-images calls the same generateImage stack (Fal-first when FAL_KEY is set; hero/image sections use 16:9). Set EMAIL_RESOLVE_DEBUG=1 to include per-slot model/backend and prompts in the JSON response.
# Email resolve idempotency (Idempotency-Key header): uses Redis when REDIS_URL is configured unless EMAIL_RESOLVE_REDIS=0 (in-process Map fallback for single-instance dev).
# EMAIL_RESOLVE_REDIS=0
# Email paper-plane overlay (POST /api/marketing/overlay-assets/generate): same Fal-first routing when FAL_KEY is set; falls back to Vertex/Gemini/OpenAI. Send JSON skip_fal:true only if you want Gemini/Vertex before Fal. Uses overlay_paper_plane + optional FAL_OVERLAY_IMAGE_MODEL (see docs/fal-model-matrix.md).
# The client invokes this when assembling an email in the builder; `executeContentWorkflow` does not pre-generate email section images (Instagram is different). Server-only pre-resolve would require a new job/flag if needed for headless sends.
# Global Publisher (curl-style): same host as streamGenerateContent but use :generateContent for images.
# GEMINI_AIPLATFORM_API_KEY=   # or GOOGLE_CLOUD_API_KEY — Google Cloud API key for https://aiplatform.googleapis.com/v1/publishers/google/models/MODEL:generateContent?key=
# Vertex AI (optional; after global key). Regional OAuth — not the same as AI Studio API key.
# VERTEX_AI_PROJECT=your-gcp-project-id
# VERTEX_AI_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json   # or rely on Cloud Run/GCE metadata
# VERTEX_AI_ACCESS_TOKEN=   # optional short-lived Bearer (CI); prefer ADC in production
# GEMINI_VERTEX_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation   # optional override for Vertex (else same list as GEMINI_IMAGE_GEN_MODEL)
# IMAGE_GEN_OPENAI_GEMINI_ONLY=1   # OpenAI Images + Gemini only; skips Fal and LiteLLM for images.
# IMAGE_GEN_OPENAI_GEMINI_ONLY=0   # Allow Fal and LiteLLM when keys are set (default).
# IMAGE_GEN_OPENAI_BEFORE_GEMINI=1 # After Fal: OpenAI Images before Vertex/Gemini (recommended if logs show Gemini 400/404/NO_IMAGE and OpenAI succeeds).
# FAL_KEY=                         # Fal AI — https://fal.ai (also FAL_AI_API_KEY or FALAI_API_KEY). Required for Fal-first image routing.
# IMAGE_GEN_DISABLE_FAL=1          # Skip Fal even when FAL_KEY is set (use Gemini/OpenAI/LiteLLM only). Omit for Fal-first (default when key is present).
# FAL_IMAGE_MODEL=fal-ai/flux/dev  # optional; e.g. fal-ai/flux/schnell (non-email marketing when FAL_EMAIL_IMAGE_MODEL unset)
# FAL_INSTAGRAM_IMAGE_MODEL=      # optional; default fal-ai/flux-pro/v1.1. For maximum Fal quality (slower/costlier) try: fal-ai/flux-pro/v1.1-ultra
# FAL_INSTAGRAM_FLUX_GUIDANCE_SCALE=3.75   # optional; app default for instagram_feed when FAL_FLUX_GUIDANCE_SCALE unset (quality-first)
# FAL_INSTAGRAM_FLUX_NUM_INFERENCE_STEPS=50  # optional; app default for instagram_feed when FAL_FLUX_NUM_INFERENCE_STEPS unset (quality-first)
# FAL_INSTAGRAM_BLACK_FRAME_MAX_MEAN=14     # optional; mean RGB 0–255 on downscaled decode; below this → retry Fal (near-black “empty” frames)
# FAL_INSTAGRAM_POST_JPEG_MIN_MEAN_LUM=18   # optional; after flatten to opaque JPEG, mean luminance must be ≥ this or non-Fal repair may run (ignored when INSTAGRAM_IMAGE_FAL_ONLY is on; raw PNG stats can read 0 while the JPEG is still valid)
# FAL_INSTAGRAM_MIN_SIZE_RATIO=0.9          # optional; decoded short edge ≥ ratio × request (e.g. 1080 → ≥972px). Lower to 0.85 if Fal returns ~1024 for 1080 requests.
# FAL_INSTAGRAM_MIN_OUTPUT_BYTES=0          # optional; if >0, also reject Fal output under this byte count (default 0 = use dimensions only; tiny files can still be valid JPEG)
# Instagram realistic feed (Lucy + POST …/regenerate-image): shared pipeline uses Fal-first T2I; defaults below match server code (set 0/false to opt out)
# INSTAGRAM_IMAGE_FAL_ONLY=1              # default on when unset — no Gemini/OpenAI/LiteLLM for instagram_feed when Fal is configured
# INSTAGRAM_FAL_DIRECT_PROMPT=1           # default on when unset — short user-aligned Flux prompt (not full enhanceImagePrompt essay)
# INSTAGRAM_FAL_OUTPUT_JPEG=1             # optional — request JPEG from Fal for instagram_feed (often better than PNG+alpha for luminance checks)
# Optional: `npm run generate:login-plane` writes client/public/login/plane-base.png (512px; Fal when FAL_KEY set, else vector) for the login welcome panel.
# FAL_EMAIL_IMAGE_MODEL=           # optional; used when generateImage.email_campaign=true (POST resolve-email-images). Stronger Flux endpoints recommended for email heroes.
# FAL_OVERLAY_IMAGE_MODEL=         # optional; VA2 paper-plane overlays only — PNG/alpha-friendly model; if unset, FAL_IMAGE_MODEL / flux/dev
# FAL_NEGATIVE_PROMPT=             # optional; default anti-text/UI negative is built-in if unset
# FAL_EMAIL_NEGATIVE_PROMPT=       # optional; appended to negative when technical_platform_topic (e.g. A2P SMS / API copy)
# FAL_FLUX_GUIDANCE_SCALE=       # optional; e.g. 3.5 — passed to Flux when set
# FAL_FLUX_NUM_INFERENCE_STEPS=  # optional; e.g. 28 — passed to Flux when set
# User-uploaded real photos → AI additive edits (POST /marketing/content/:id/reference-image + ai-photo-edit; Instagram pipeline when reference_image_url is set):
# Reference download: server fetches the image URL (anonymous GET, then Supabase service-role GET if the bucket is not public). Requires real Supabase URLs — dev mock storage URLs cannot be re-fetched.
# INSTAGRAM_REFERENCE_EDIT_BACKEND=   # optional; unset = FLUX Kontext (image+instruction). Set to flux_i2i to use Fal Flux image-to-image (same FAL_KEY; closer to raw Flux T2I behavior).
# FAL_INSTAGRAM_REFERENCE_I2I_MODEL=    # optional; default fal-ai/flux/dev/image-to-image (overrides FAL_FLUX_I2I_MODEL when set)
# FAL_FLUX_I2I_MODEL=                 # optional fallback model id for flux_i2i backend
# FAL_FLUX_I2I_STRENGTH=0.65          # optional; 0.05–0.99 — lower keeps more of the original photo (default 0.65; Fal API default is 0.95)
# FAL_FLUX_I2I_GUIDANCE_SCALE=        # optional; CFG for img2img
# FAL_FLUX_I2I_NUM_INFERENCE_STEPS=   # optional
# FAL_FLUX_I2I_SUBSCRIBE_TIMEOUT_MS=600000   # optional; Fal client wait for img2img queue
# FAL_IMAGE_EDIT_MODEL=fal-ai/flux-pro/kontext   # optional; FLUX Kontext (image_url + prompt). Cheaper: fal-ai/flux-kontext/dev
# FAL_KONTEXT_GUIDANCE_SCALE=    # optional; CFG. App default is 3 when unset (Fal’s raw default is 3.5). Try 2.8–3.2 for softer, more photographic blends; higher = stricter prompt adherence.
# FAL_KONTEXT_NUM_INFERENCE_STEPS=   # optional; only sent if set — verify your endpoint accepts it (some Kontext builds ignore this field).
# FAL_KONTEXT_ENHANCE_PROMPT=0      # optional; 0/false = Fal does not paraphrase the prompt (often better for photoreal scene-locked edits). 1/true = enable.
# FAL_KONTEXT_SUBSCRIBE_TIMEOUT_MS=600000   # optional; Fal client wait for queue+job (default 10 min)
# FAL_KONTEXT_START_TIMEOUT_SEC=600        # optional; Fal server queue wait before run starts (default 10 min)
# FAL_KONTEXT_MAX_ATTEMPTS=3               # optional; retries on Gateway Timeout / 5xx (max 5)
# FAL_KONTEXT_OUTPUT_FORMAT=jpeg           # optional; jpeg (default, opaque) or png — png alpha looks black on dark previews
# If generated images still show embedded email headlines or fake UI, the pipeline uses a semantic campaign prefix (topic keywords) plus these negatives — avoid pasting full subject lines into FAL_NEGATIVE_PROMPT alone.
# Recommended for quality + reliability: OpenAI DALL·E 3 (defaults to quality=hd in code).
# GOOGLE_GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=dall-e-3
# OPENAI_IMAGE_QUALITY=hd          # recommended: hd (finer detail); standard = faster/cheaper
# OPENAI_IMAGE_STYLE=natural       # optional; vivid = bolder — photoreal Instagram prompts in-app often force `natural` when style_preset=photoreal
# (omit OPENAI_IMAGE_STYLE to use the API default vivid)
# If LITELLM_MASTER_KEY is unset, LiteLLM is skipped; Gemini uses Vertex (if configured) or AI Studio key above.
# Optional: pin one model for generateContent (IMAGE). Default tries only gemini-2.0-flash-preview-image-generation (other Flash ids usually 400/NO_IMAGE on IMAGE modality).
# Native API uses systemInstruction + IMAGE modality; prompt tuning cannot fix all NO_IMAGE cases — pin a known image-capable id when needed.
# GEMINI_IMAGE_GEN_MODEL=          # optional: primary IMAGE-capable id from ListModels for your key/region
# GEMINI_IMAGE_GEN_MODEL_FALLBACKS=  # optional comma-separated extra ids tried after GEMINI_IMAGE_GEN_MODEL (or after the default preview id when unset)
# Direct Gemini OpenAI-compat model (balanced/vision tiers when LiteLLM is off). Default: gemini-2.0-flash-001 (gateway retries a few ids on 404).
# GEMINI_CHAT_MODEL=gemini-2.0-flash-001
# ANTHROPIC_API_KEY=

# ============== Optional (LLM model overrides — llmGateway.ts) ==============
# Override default models and timeouts for the dual-tier LLM gateway.
# LLM_COMPLEX_MODEL=claude-sonnet-4-20250514   # Model for complex/synthesis tasks (used by both gateways)
# LLM_COMPLEX_TIMEOUT_MS=45000
# LLM_FAST_MODEL=llama-3.3-70b-versatile          # Model for fast categorization (Groq)
# LLM_FAST_TIMEOUT_MS=15000

# ============== Optional (LiteLLM AI Gateway) ==============
# When using LiteLLM proxy (litellm/config.yaml), set:
# LITELLM_MASTER_KEY=sk-your-master-key   # Required — suppresses CRITICAL; use sk-litellm for local dev
# LITELLM_URL=http://localhost:4000/v1
# Optional: explicit base for marketing image gen (else LITELLM_URL is used). See publishing/imageService.ts
# LITELLM_GATEWAY_URL=http://localhost:4000
# IMAGE_GEN_MODEL=gemini/gemini-2.0-flash-exp
# IMAGE_GEN_DEV_FALLBACK=true   # Sprint 3: immediate placehold.co URL (prompt in image); full IG pipeline without LiteLLM/Supabase
# IMAGE_GEN_DEV_FALLBACK=0      # disable (use real backends when keys are set)
# IMAGE_GEN_PLACEHOLDER_URL=    # optional fixed URL; if unset, placehold.co embeds first 40 chars of the prompt
#
# Supabase Storage — real marketing image URLs in the UI (omit = mock storage.mock.local URLs)
# Project Settings → API: Project URL + secret (server only; never expose to Vite).
# Use either the legacy service_role JWT or the new opaque secret (`sb_secret_...`) as SUPABASE_SERVICE_ROLE_KEY.
# Bucket: create `marketing-images` in Storage UI as Public, or run db/supabase-marketing-images-bucket.sql
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Optional (dashboard / client tooling): SUPABASE_ANON_KEY=  SUPABASE_PUBLISHABLE_KEY=
# Optional: direct Postgres URL (Dashboard → Database password). For supabase db push / psql — not the same as SUPABASE_URL above.
# SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# MARKETING_IMAGE_BUCKET=marketing-images
# When Instagram adapter skips (no image_url), calendar row stays scheduled and retries after this many minutes (default 60).
# MARKETING_IG_SKIP_RETRY_MINUTES=60

# ============== Optional (Marketing Publisher Cron) ==============
# Default OFF (ADR-004). Set to 1 to enable the background publisher cron job.
# MARKETING_PUBLISHER_ENABLED=1
# Timezone for cron scheduling (IANA, default UTC)
# MARKETING_PUBLISHER_TZ=UTC

# ============== Engage database role (ADR-002) ==============
# Engage uses its own pool on the dedicated messign_engage role (NOSUPERUSER, NOBYPASSRLS). Migration 111 creates
# the role without a login; set one with db/scripts/create_engage_role.sql. There is no fallback to DATABASE_URL.
# If this is unset, or the role can bypass RLS, /api/engage is not mounted (the server logs why).
# ENGAGE_DATABASE_URL=postgresql://messign_engage:YOUR_ENGAGE_PASSWORD@localhost:5432/messign
# Slug of the platform organization whose admins may provision engage tenants (default: messign).
# PLATFORM_ORG_SLUG=messign

# ============== Product surface (ADR-001) ==============
# workspace (default when unset) | engage | all. With engage, frozen Company-OS routers, modules and
# their cron jobs do not start, so those routes return 404. Any other value stops the server at boot.
# Pair with VITE_PRODUCT_SURFACE on the client. /api/seed never mounts when NODE_ENV=production.
# PRODUCT_SURFACE=workspace

# ============== Send gate (ADR-004) ==============
# Single switch for every legacy marketing adapter (email/LinkedIn/X/Instagram/blog webhook).
# off (default, also any unset/invalid value) | sandbox | live. Only "live" lets an adapter
# make a real outbound call when credentials are configured — everything else always mocks.
# SEND_MODE=off

# ============== Optional (Calibration snapshot cron — Phase 7) ==============
# Weekly enqueue of marketing/calibration-snapshot (pg-boss). Set to 0 to disable cron registration.
# CALIBRATION_SNAPSHOT_CRON_ENABLED=0
# CALIBRATION_SNAPSHOT_TZ=UTC

# ============== Optional (Social Publishing Adapters) ==============
# All gated by SEND_MODE above (credentials alone no longer trigger a real send).
# X (Twitter) — server/src/services/marketing/publishing/adapters/xAdapter.ts
# TWITTER_BEARER_TOKEN=           # or X_BEARER_TOKEN (both checked)

# LinkedIn — server/src/services/marketing/publishing/adapters/linkedinAdapter.ts
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=urn:li:organization:0   # Author URN for LinkedIn posts

# Instagram / Meta — server/src/services/marketing/publishing/adapters/instagramAdapter.ts
# META_GRAPH_ACCESS_TOKEN=        # Meta Graph API token for publishing
# INSTAGRAM_BUSINESS_ACCOUNT_ID=  # Business account ID for Instagram posts

# Email sending — server/src/services/marketing/publishing/adapters/emailAdapter.ts
# RESEND_API_KEY=                 # Resend.com API key (preferred over SendGrid)
# SENDGRID_API_KEY=               # SendGrid API key (fallback if no Resend key)
# MARKETING_EMAIL_FROM=marketing@example.com   # From address for marketing emails
# MARKETING_EMAIL_TEST_TO=test@example.com     # Default test recipient

# Blog adapter — server/src/services/marketing/publishing/adapters/blogAdapter.ts (also gated by SEND_MODE)
# MARKETING_BLOG_WEBHOOK_URL=     # Webhook endpoint for blog publishing
# MARKETING_BLOG_WEBHOOK_SECRET=  # Secret for X-Webhook-Secret header
# MARKETING_KH_PUBLISH_URL=       # Knowledge Hub internal publish endpoint
#
# Redis for LiteLLM semantic cache (uses same REDIS_URL as BullMQ when npm run litellm loads .env)
# REDIS_HOST=localhost  (or REDIS_URL=redis://localhost:6379)
# REDIS_PORT=6379

# ============== Optional (invoices / company) ==============
# COMPANY_NAME=Messign Communications
# COMPANY_ADDRESS=Delaware, USA
# COMPANY_REG_NUMBER=13799611524
# COMPANY_VAT_NUMBER=030319941
# INVOICE_PREFIX=MSG

# ============== Optional (security) ==============
# ENCRYPTION_KEY=your-64-char-hex-string-here

# ============== Optional (cron / seed) ==============
# SEED_SECRET=  (for POST /api/seed cron; or CRON_SECRET)
# CRON_SECRET=  (alternative to SEED_SECRET for Vercel Cron)
# MARKETING_SEED_ORG_SLUG=messign  (org slug for db:seed-marketing and /api/seed/marketing)
# Default password for seeded/bulk-imported users (required for db:seed and initAuth).
# Keep the same value on every environment (local, Railway, etc.). Apply to existing DBs: npm run auth:set-alex
SEED_DEFAULT_PASSWORD=test123

# ============== Dora AI ==============
# When true, POST /api/knowledge-hub/ai/answer always uses the v2 pipeline (SSE). v2 is also mounted at POST /api/v2/ai/answer.
# Marketing cockpit sends marketingAgentMode: true — that always routes to v2 even when DORA_V2_ENABLED is false.
DORA_V2_ENABLED=false
# Optional: override default LLM for v2 brain (server implementation — see routes/knowledge-hub).
# DORA_DEFAULT_MODEL=
# Optional: base URL if Dora routes proxy to an external brain (rare).
# DORA_BRAIN_URL=
# Lucy (CMO persona): when true, prepends orchestrator/specialist Lucy layers for marketing agent mode. Set false to disable.
LUCY_PERSONA_ENABLED=true
# Max wall time (ms) for the marketing sub-orchestrator (runMarketingSubOrchestratorFlow). Default 180000 (3 min).
# Instagram flows often run Fal then optional Gemini/OpenAI; 90000 was too short and surfaced empty Lucy replies.
# MARKETING_FLOW_TIMEOUT_MS=180000

# ============== Creative Hub — Replicate / Flux (Sprint 1+ scaffold: server/src/modules/creative) ==============
# https://replicate.com — token is server-only; never expose to Vite.
# REPLICATE_API_TOKEN=
# Default Flux-family model id on Replicate (change per product choice).
# REPLICATE_FLUX_MODEL=black-forest-labs/flux-schnell
# Optional defaults for generation (implementation will read these).
# CREATIVE_IMAGE_DEFAULT_WIDTH=1024
# CREATIVE_IMAGE_DEFAULT_HEIGHT=1024
# CREATIVE_IMAGE_PROVIDER=replicate

# ============== Marketing Automation (Sprint 1+ scaffold: server/src/modules/marketing_automation) ==============
# Future: queue driver, webhook signing, external ESP — add keys here as features land.
# MARKETING_AUTOMATION_WEBHOOK_SECRET=

# ============== Unlayer (Marketing email builder) ==============
# Numeric Project ID goes on the CLIENT only: VITE_UNLAYER_PROJECT_ID in client/.env (see client/.env.example).
#
# Project API Key (Developer Console → Project → Settings): used for Unlayer Cloud REST API (api.unlayer.com)
# with Basic auth — server-side only. Never prefix with VITE_ or commit real values.
# UNLAYER_API_KEY=
#
# Optional: Project Secret (Security / identity verification): server-only HMAC for embed user signatures — different
# from the Cloud API key. If you enable identity verification in Unlayer, set UNLAYER_PROJECT_SECRET and use
# GET /api/marketing/unlayer/embed-user (see server route). Never expose in the browser.
# UNLAYER_PROJECT_SECRET=

# ============== Optional (other) ==============
# GRAPHHOPPER_API_KEY=
# ACCESS_TOKEN_EXPIRY=15m
# REFRESH_TOKEN_EXPIRY=7d
# ADMIN_PASSWORD=   (for `npm run create-admin` only; optional ADMIN_EMAIL overrides default hamza@messign.com)
