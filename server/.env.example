# ============== Required ==============
# PostgreSQL connection string
# CRITICAL: Use the restricted messign_app role (NOT postgres) so RLS is enforced.
# Run: ./db/scripts/run_create_app_role.sh (or psql -f db/scripts/create_app_role.sql)
# Then set DATABASE_URL to the messign_app connection string.
#
# Local dev: postgresql://messign_app:<password>@localhost:5432/messign
# Railway:   postgresql://messign_app:<password>@<host>:<port>/railway?sslmode=require
DATABASE_URL=postgresql://messign_app:YOUR_APP_PASSWORD@localhost:5432/messign
#
# If you see `permission denied for schema public` or MV refresh errors on server boot:
# the app role cannot run DDL/REFRESH. That is expected — use DATABASE_ADMIN_URL for
# migrations, or ignore those lines for local dev. For a friction-free local DB only,
# you may point DATABASE_URL at postgres (not recommended for shared/prod-shaped data).

# Admin URL for migrations (postgres/superuser). Required for db:apply-rls, db:migrate.
# If unset, falls back to DATABASE_PUBLIC_URL then DATABASE_URL.
# DATABASE_ADMIN_URL=postgresql://postgres:<password>@<host>:<port>/railway?sslmode=require

# Optional: force `npm run db:migrate-runner` to a specific database when DATABASE_URL points
# at cloud but you develop against local Postgres (e.g. approval queue missing on :3000).
# Use a role that exists on your machine: Homebrew Postgres often uses your macOS username, not `postgres`.
# DATABASE_MIGRATE_URL=postgresql://messign_app:YOUR_APP_PASSWORD@localhost:5432/messign
# Example (superuser / owner): postgresql://$(whoami)@localhost:5432/messign

# PgBouncer (optional): When set, app connects via PgBouncer for connection pooling.
# Must use messign_app role (same as DATABASE_URL) for RLS to work.
# Use port 6432 (PgBouncer) instead of 5432 (PostgreSQL). Requires pool_mode=transaction for RLS.
# PGBOUNCER_URL=postgresql://messign_app:YOUR_APP_PASSWORD@localhost:6432/messign_production

# Redis (required for BullMQ, cache, Dora scheduler)
# Local: redis://localhost:6379 | Railway: use Redis plugin URL
REDIS_URL=redis://localhost:6379

# Set to 1 to disable Socket.IO Redis adapter (in-memory only; not safe with multiple Railway replicas).
# SKIP_SOCKET_REDIS_ADAPTER=1

# Background workers (BullMQ, Dora scheduler). Set to false if Redis is unavailable — marketing batch jobs
# and other Redis-backed workers will not run.
# ENABLE_WORKERS=false
#
# pg-boss (Postgres-backed queue) for competitor scrape jobs and marketing batch handoff. Runs when
# DATABASE_URL is set and ENABLE_PG_BOSS is not false — independent of ENABLE_WORKERS so scrapes still
# enqueue when Redis workers are off. Requires the `pgboss` schema (created when pg-boss starts) and
# migrations that add competitor intelligence tables (e.g. server/src/migrations/100_competitor_intelligence.sql,
# 102_competitor_last_scrape_summary.sql).
# ENABLE_PG_BOSS=false
#
# Optional: direct Postgres URL for pg-boss only. Use when DATABASE_PUBLIC_URL is a transaction pooler
# (e.g. Neon) — pg-boss needs a session-capable or direct connection. If unset, order is:
# DATABASE_URL, then DATABASE_PUBLIC_URL.
# PG_BOSS_DATABASE_URL=postgresql://messign_app:...@host:5432/db?sslmode=require

# Optional: log [SLOW] when request time exceeds this many ms (default: 500 prod, 2000 dev)
# SLOW_LOG_MS=500

# Optional: set to 1 to disable IP/User-Agent fingerprint checks on JWT (debug only; not for production)
# DISABLE_SESSION_FINGERPRINT=
# Optional: set to 1 to enforce fingerprint even on localhost/LAN (default: relaxed on private hosts when NODE_ENV=production)
# SESSION_FINGERPRINT_STRICT=

# JWT secrets (use long random strings in production)
JWT_SECRET=your-access-secret-change-in-production
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# ============== Required for Production ==============
# Frontend URL for CORS (Vercel production domain, e.g. https://messign.vercel.app)
# MUST match your Vercel URL exactly (https, no trailing slash).
# Refresh cookies use SameSite=None in production; CLIENT_URL is still required so CORS allows your origin.
# CLIENT_URL=https://your-app.vercel.app

# Additional CORS origins (comma-separated, for Vercel preview URLs)
# ADDITIONAL_CORS_ORIGINS=https://messign-git-main-xxx.vercel.app,https://messign-xxx.vercel.app

# PII encryption (required in production; fail-fast if unset)
# ENCRYPTION_KEY=your-64-char-hex-string-here

# ============== Optional (server) ==============
# PORT=3001
# NODE_ENV=production
# UPLOAD_DIR=./uploads
# LOG_LEVEL=info   # debug | info | warn | error (default: info in prod, debug in dev)

# Pooled / public DB URL (Neon, Supabase pooler, etc.); used as fallback when DATABASE_URL is unset
# DATABASE_PUBLIC_URL=

# ============== Optional (AI / Knowledge Hub) ==============
# GROQ_API_KEY=
# GROQ_OPENAI_BASE_URL=https://api.groq.com/openai/v1   # Override Groq base URL for OpenAI-compat calls
#
# --- Marketing / Instagram images (set at least ONE backend) ---
# Routing: OpenAI Images first if OPENAI_API_KEY → else LiteLLM if LITELLM_MASTER_KEY → else direct Gemini if GOOGLE_GEMINI_API_KEY.
# Recommended for quality + reliability: OpenAI DALL·E 3 (defaults to quality=hd in code).
# GOOGLE_GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=dall-e-3
# OPENAI_IMAGE_QUALITY=hd
# OPENAI_IMAGE_STYLE=vivid
# (quality: `standard` = faster/cheaper; style: `natural` = more photographic — omit OPENAI_IMAGE_STYLE for API default)
# Marketing images: when set, OpenAI Images is used first; then LiteLLM (if LITELLM_MASTER_KEY) or direct Gemini.
# Also used as Gemini fallback when Gemini returns NO_IMAGE / tool-style JSON (skipped if OpenAI-first already failed).
# Marketing images: if LITELLM_MASTER_KEY is unset, the server calls Gemini native image API with this key.
# Optional: pin one model for generateContent (IMAGE). If unset, tries preview image-gen then gemini-flash-latest, etc.
# Native API uses systemInstruction + IMAGE modality; prompt tuning cannot fix all NO_IMAGE cases — pin a known image-capable id when needed.
# GEMINI_IMAGE_GEN_MODEL=gemini-2.0-flash-preview-image-generation
# Direct Gemini OpenAI-compat model (balanced/vision tiers when LiteLLM is off). Default: gemini-2.0-flash-001 (gateway retries a few ids on 404).
# GEMINI_CHAT_MODEL=gemini-2.0-flash-001
# ANTHROPIC_API_KEY=

# ============== Optional (LLM model overrides — llmGateway.ts) ==============
# Override default models and timeouts for the dual-tier LLM gateway.
# LLM_COMPLEX_MODEL=claude-3-5-sonnet-20241022   # Model for vision/synthesis tasks
# LLM_COMPLEX_TIMEOUT_MS=45000
# LLM_FAST_MODEL=llama-3.3-70b-versatile          # Model for fast categorization (Groq)
# LLM_FAST_TIMEOUT_MS=15000

# ============== Optional (LiteLLM AI Gateway) ==============
# When using LiteLLM proxy (litellm/config.yaml), set:
# LITELLM_MASTER_KEY=sk-your-master-key   # Required — suppresses CRITICAL; use sk-litellm for local dev
# LITELLM_URL=http://localhost:4000/v1
# Optional: explicit base for marketing image gen (else LITELLM_URL is used). See publishing/imageService.ts
# LITELLM_GATEWAY_URL=http://localhost:4000
# IMAGE_GEN_MODEL=gemini/gemini-2.0-flash-exp
# IMAGE_GEN_DEV_FALLBACK=true   # Sprint 3: immediate placehold.co URL (prompt in image); full IG pipeline without LiteLLM/Supabase
# IMAGE_GEN_DEV_FALLBACK=0      # disable (use real backends when keys are set)
# IMAGE_GEN_PLACEHOLDER_URL=    # optional fixed URL; if unset, placehold.co embeds first 40 chars of the prompt
#
# Supabase Storage — real marketing image URLs in the UI (omit = mock storage.mock.local URLs)
# Project Settings → API: Project URL + secret (server only; never expose to Vite).
# Use either the legacy service_role JWT or the new opaque secret (`sb_secret_...`) as SUPABASE_SERVICE_ROLE_KEY.
# Bucket: create `marketing-images` in Storage UI as Public, or run db/supabase-marketing-images-bucket.sql
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Optional (dashboard / client tooling): SUPABASE_ANON_KEY=  SUPABASE_PUBLISHABLE_KEY=
# Optional: direct Postgres URL (Dashboard → Database password). For supabase db push / psql — not the same as SUPABASE_URL above.
# SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# MARKETING_IMAGE_BUCKET=marketing-images
# When Instagram adapter skips (no image_url), calendar row stays scheduled and retries after this many minutes (default 60).
# MARKETING_IG_SKIP_RETRY_MINUTES=60

# ============== Optional (Marketing Publisher Cron) ==============
# Set to 0 to disable the background publisher cron job entirely
# MARKETING_PUBLISHER_ENABLED=1
# Timezone for cron scheduling (IANA, default UTC)
# MARKETING_PUBLISHER_TZ=UTC

# ============== Optional (Social Publishing Adapters) ==============
# X (Twitter) — server/src/services/marketing/publishing/adapters/xAdapter.ts
# TWITTER_BEARER_TOKEN=           # or X_BEARER_TOKEN (both checked)
# X_FORCE_REAL=1                  # set to 1 to send real posts (mock by default)

# LinkedIn — server/src/services/marketing/publishing/adapters/linkedinAdapter.ts
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=urn:li:organization:0   # Author URN for LinkedIn posts
# LINKEDIN_FORCE_MOCK=1           # force mock mode even when token is set

# Instagram / Meta — server/src/services/marketing/publishing/adapters/instagramAdapter.ts
# META_GRAPH_ACCESS_TOKEN=        # Meta Graph API token for publishing
# INSTAGRAM_BUSINESS_ACCOUNT_ID=  # Business account ID for Instagram posts

# Email sending — server/src/services/marketing/publishing/adapters/emailAdapter.ts
# RESEND_API_KEY=                 # Resend.com API key (preferred over SendGrid)
# SENDGRID_API_KEY=               # SendGrid API key (fallback if no Resend key)
# EMAIL_FORCE_REAL=1              # set to 1 to send real emails (mock by default)
# MARKETING_EMAIL_FROM=marketing@example.com   # From address for marketing emails
# MARKETING_EMAIL_TEST_TO=test@example.com     # Default test recipient

# Blog adapter — server/src/services/marketing/publishing/adapters/blogAdapter.ts
# MARKETING_BLOG_WEBHOOK_URL=     # Webhook endpoint for blog publishing
# MARKETING_BLOG_WEBHOOK_SECRET=  # Secret for X-Webhook-Secret header
# MARKETING_KH_PUBLISH_URL=       # Knowledge Hub internal publish endpoint
#
# Redis for LiteLLM semantic cache (uses same REDIS_URL as BullMQ when npm run litellm loads .env)
# REDIS_HOST=localhost  (or REDIS_URL=redis://localhost:6379)
# REDIS_PORT=6379

# ============== Optional (invoices / company) ==============
# COMPANY_NAME=Messign Communications
# COMPANY_ADDRESS=Delaware, USA
# COMPANY_REG_NUMBER=13799611524
# COMPANY_VAT_NUMBER=030319941
# INVOICE_PREFIX=MSG

# ============== Optional (security) ==============
# ENCRYPTION_KEY=your-64-char-hex-string-here

# ============== Optional (cron / seed) ==============
# SEED_SECRET=  (for POST /api/seed cron; or CRON_SECRET)
# CRON_SECRET=  (alternative to SEED_SECRET for Vercel Cron)
# MARKETING_SEED_ORG_SLUG=messign  (org slug for db:seed-marketing and /api/seed/marketing)
# Default password for seeded/bulk-imported users (required for db:seed and initAuth)
SEED_DEFAULT_PASSWORD=changeme123!Aa

# ============== Dora AI ==============
# When true, POST /api/knowledge-hub/ai/answer always uses the v2 pipeline (SSE). v2 is also mounted at POST /api/v2/ai/answer.
# Marketing cockpit sends marketingAgentMode: true — that always routes to v2 even when DORA_V2_ENABLED is false.
DORA_V2_ENABLED=false
# Optional: override default LLM for v2 brain (server implementation — see routes/knowledge-hub).
# DORA_DEFAULT_MODEL=
# Optional: base URL if Dora routes proxy to an external brain (rare).
# DORA_BRAIN_URL=

# ============== Creative Hub — Replicate / Flux (Sprint 1+ scaffold: server/src/modules/creative) ==============
# https://replicate.com — token is server-only; never expose to Vite.
# REPLICATE_API_TOKEN=
# Default Flux-family model id on Replicate (change per product choice).
# REPLICATE_FLUX_MODEL=black-forest-labs/flux-schnell
# Optional defaults for generation (implementation will read these).
# CREATIVE_IMAGE_DEFAULT_WIDTH=1024
# CREATIVE_IMAGE_DEFAULT_HEIGHT=1024
# CREATIVE_IMAGE_PROVIDER=replicate

# ============== Marketing Automation (Sprint 1+ scaffold: server/src/modules/marketing_automation) ==============
# Future: queue driver, webhook signing, external ESP — add keys here as features land.
# MARKETING_AUTOMATION_WEBHOOK_SECRET=

# ============== Unlayer (Marketing email builder) ==============
# Numeric Project ID goes on the CLIENT only: VITE_UNLAYER_PROJECT_ID in client/.env (see client/.env.example).
#
# Project API Key (Developer Console → Project → Settings): used for Unlayer Cloud REST API (api.unlayer.com)
# with Basic auth — server-side only. Never prefix with VITE_ or commit real values.
# UNLAYER_API_KEY=
#
# Optional: Project Secret (Security / identity verification): server-only HMAC for embed user signatures — different
# from the Cloud API key. If you enable identity verification in Unlayer, set UNLAYER_PROJECT_SECRET and use
# GET /api/marketing/unlayer/embed-user (see server route). Never expose in the browser.
# UNLAYER_PROJECT_SECRET=

# ============== Optional (other) ==============
# GRAPHHOPPER_API_KEY=
# ACCESS_TOKEN_EXPIRY=15m
# REFRESH_TOKEN_EXPIRY=7d
# ADMIN_PASSWORD=  (for create-admin script only)
