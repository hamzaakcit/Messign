{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "(npx kill-port 3001 || true) && tsx watch --ignore './uploads/**' --ignore './**/*.test.ts' --ignore './src/db/seeds/**' --ignore './src/scripts/**' --ignore './src/migrations/**' src/index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/migrations/runner.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:fix-columns": "tsx src/db/fixMissingColumns.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:finance-seed": "tsx src/db/runFinanceSeed.ts",
    "db:seed-marketing": "tsx src/db/runMarketingSeed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "import-employees": "tsx src/scripts/importEmployeesFromFile.ts",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "auth:set-alex": "tsx src/scripts/setAlexPassword.ts",
    "db:ensure-departments": "tsx src/scripts/ensureDepartments.ts",
    "db:embed-knowledge": "tsx src/db/embedKnowledgeDocs.ts",
    "kpi:validate": "tsx src/scripts/validateExecutiveKpis.ts",
    "audit:perf": "tsx src/scripts/performanceAudit.ts",
    "launch:check": "tsx src/scripts/launchChecklist.ts",
    "db:verify-rls": "tsx src/scripts/verifyRls.ts",
    "db:diagnose-rls": "tsx src/scripts/diagnoseRls.ts",
    "db:apply-rls": "tsx src/scripts/applyRlsMigrations.ts",
    "db:check-org-gaps": "tsx src/scripts/checkOrganizationIdGaps.ts",
    "engage:rewrap-keys": "tsx src/scripts/rewrapEngageKeys.ts",
    "engage:import": "tsx src/scripts/engageImport.ts",
    "engage:add-account": "tsx src/scripts/engageAddAccount.ts",
    "engage:synthetic": "tsx src/scripts/engageSynthetic.ts",
    "litellm": "python3 -m litellm --config ../litellm/config.yaml",
    "test:agents": "vitest run",
    "test:red-team": "tsx src/scripts/redTeam/testMarketingGatekeepers.ts",
    "test:red-team:mock": "RED_TEAM_MOCK_LLM=1 tsx src/scripts/redTeam/testMarketingGatekeepers.ts",
    "marketing:print-context": "tsx src/scripts/printMarketingContext.ts",
    "db:force-fix": "tsx src/force-db-fix.ts",
    "generate:login-plane": "node ../scripts/generate-login-paper-plane-fal.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@fal-ai/client": "1.9.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/cookie-parser": "^1.4.10",
    "adm-zip": "^0.5.16",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.70.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "fuse.js": "^7.1.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.11.0",
    "mitt": "^3.0.1",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "openai": "^6.22.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "pg-boss": "^12.14.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.34.5",
    "puppeteer": "^24.37.2",
    "socket.io": "^4.7.4",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.16",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
