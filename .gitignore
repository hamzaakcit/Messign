# Dependencies and build outputs (root and all subdirs)
node_modules/
**/node_modules/
dist/
**/dist/

# Env and secrets
.env
.env.*
!.env.example

# Neon CLI (OAuth tokens under ~/.config/neonctl/ — never commit copies into the repo)
.config/neonctl/

# OS and editor
.DS_Store
.CFUserTextEncoding
*.log

# Local tool caches (Prisma download cache, Puppeteer browsers, etc.)
.cache/
.npm-cache/

# Vercel
.vercel/

# Optional but recommended: TS build info, coverage, local uploads
*.tsbuildinfo
coverage/
server/uploads/
.vercel

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
e2e/.auth/
e2e-engage/.auth/
