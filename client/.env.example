# ============== Production (Vercel) ==============
# Backend API URL. Set in Vercel Environment Variables for production.
# If unset, production build uses fallback: https://server-production-7283.up.railway.app
# Override if your Railway backend has a different URL:
# VITE_API_URL=https://your-railway-backend.up.railway.app

# ============== Local Development ==============
# Leave unset for local dev; Vite proxy forwards /api to localhost:3001
