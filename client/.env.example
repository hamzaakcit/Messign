# ============== Production (Vercel) ==============
# Backend API root (no trailing slash, no /api). Set in Vercel → Environment Variables.
# MUST be your Railway (or other) API host — NOT https://your-app.vercel.app (that serves SPA HTML and breaks Dora SSE).
# VITE_API_ORIGIN is accepted as an alias for the same value.
# VITE_API_URL=https://your-railway-backend.up.railway.app
#
# If Socket.IO WebSocket upgrade fails (400 on polling / "closed before established"), try polling-only:
# VITE_SOCKET_FORCE_POLLING=1

# ============== Local Development ==============
# Leave unset for local dev; Vite proxy forwards /api to localhost:3001

# Dora v2 brain: when true, chat uses POST /api/v2/ai/answer (see client/src/hooks/useDora.ts).
# When false, Marketing still uses the v2 pipeline if the client sends marketingAgentMode (server delegates from POST /api/knowledge-hub/ai/answer).
VITE_DORA_V2=false
# Optional: feature-flag Creative Hub UI sections (when implemented; no effect until code reads it).
# VITE_CREATIVE_HUB_ENABLED=true
# Optional: feature-flag Marketing Automation builder (when implemented).
# VITE_MARKETING_AUTOMATION_ENABLED=true

# Unlayer embed (react-email-editor) — Marketing → Email, Landing pages, Popups, Documents.
# Aligns with Unlayer “Get Started”: https://docs.unlayer.com/docs/getting-started
# - projectId: set below (numeric ID from https://app.unlayer.com → Project → Settings; not the Cloud API key).
# - displayMode: chosen in code per surface — email | web | popup | document (same project ID).
# - Recommended editor size (≥1024×700) is enforced in UnlayerEditor (marketing builder).
# For production: Unlayer → Project → Deployment → Allowed Domain(s) must include your SPA host
# (e.g. messign.vercel.app). Add each preview URL pattern if you use the builder on Vercel previews.
# The Project API Key belongs in server env only (UNLAYER_API_KEY) — never here.
# VITE_UNLAYER_PROJECT_ID=12345
# Optional: Unsplash API for random hero photos by query (not required — calendar email builder uses curated static URLs).
# VITE_UNSPLASH_ACCESS_KEY=
