# ============== Production (Vercel) ==============
# Backend API root (no trailing slash, no /api). Set in Vercel → Environment Variables.
# MUST be your Railway (or other) API host — NOT https://your-app.vercel.app (that serves SPA HTML and breaks Dora SSE).
# VITE_API_ORIGIN is accepted as an alias for the same value.
# VITE_API_URL=https://your-railway-backend.up.railway.app

# ============== Local Development ==============
# Leave unset for local dev; Vite proxy forwards /api to localhost:3001

# Dora v2 brain: when true, chat uses POST /api/v2/ai/answer (see client/src/hooks/useDora.ts).
VITE_DORA_V2=false
