# ============== Production (Vercel) ==============
# Backend API URL. Set in Vercel Environment Variables for production.
# MUST match your Railway backend URL exactly (e.g. https://server-production-7283.up.railway.app).
# If wrong, API calls fail with 401 and you get redirected back to login.
# VITE_API_URL=https://your-railway-backend.up.railway.app

# ============== Local Development ==============
# Leave unset for local dev; Vite proxy forwards /api to localhost:3001

# Dora v2 brain: when true, chat uses POST /api/v2/ai/answer (see client/src/hooks/useDora.ts).
VITE_DORA_V2=false
