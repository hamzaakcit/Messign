; PgBouncer userlist — copy to userlist.txt and fill with your DB credentials
; Format: "username" "md5<md5(password+username)>"
;
; Generate md5 hash (PostgreSQL style):
;   echo -n "yourpasswordyourusername" | md5sum
;   Then use: "youruser" "md5<that_hash>"
;
; Example (replace with your actual user and hash):
; "messign_app" "md5a1b2c3d4e5f6..."
